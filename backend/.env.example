# Tried in this order — set at least one. Free tiers: Gemini & Groq.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional model overrides (defaults are already free-tier friendly)
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-3.5-turbo

# Auth
JWT_SECRET=change_this_to_a_long_random_string
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=texthumanizer

# Transactional email (password reset). Without this set, reset links are
# logged to the console instead of emailed — fine for local dev.
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Text Humanizer <onboarding@resend.dev>

PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
